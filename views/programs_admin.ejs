<%- include('partials/admin_header') %>
<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
  <h2 class="text-green-dark">Manage Programmes</h2>
  <a href="/admin/programs/add" class="btn btn-gold"><i class="fas fa-plus me-1"></i>Add New</a>
</div>
<div class="row g-4">
  <% programs.forEach(p => { %>
    <div class="col-12 col-md-6 col-lg-4">
      <div class="card h-100 shadow-sm">
        <% if (p.image) { %><img src="<%= p.image %>" class="card-img-top" style="height:140px; object-fit:cover;"><% } %>
        <div class="card-body">
          <h5 class="card-title"><%= p.name %></h5>
          <p class="mb-1"><span class="badge bg-green-dark"><%= p.type %></span></p>
          <p class="small">Fee: ZMW <%= p.fee %> | Duration: <%= p.duration %></p>
          <a href="/admin/programs/edit/<%= p.id %>" class="btn btn-sm btn-outline-secondary">Edit</a>
          <form method="POST" action="/admin/programs/delete/<%= p.id %>" class="d-inline">
            <button class="btn btn-sm btn-outline-danger">Delete</button>
          </form>
        </div>
      </div>
    </div>
  <% }) %>
</div>
<%- include('partials/admin_footer') %>
