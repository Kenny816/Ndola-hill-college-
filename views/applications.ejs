<!DOCTYPE html>
<html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Applications</title>
<style>body{margin:0;font-family:sans-serif;background:#f4f6f8}.top-bar{background:#0b5e2f;color:white;padding:12px 20px;display:flex;justify-content:space-between;align-items:center}.nav a{color:white;margin:0 10px;text-decoration:none}.container{max-width:1200px;margin:20px auto;padding:0 20px}.card{background:white;padding:20px;border-radius:8px;box-shadow:0 2px 12px rgba(0,0,0,0.05);overflow-x:auto}table{width:100%;border-collapse:collapse;min-width:800px}th{background:#eaeaea;padding:8px}td{padding:8px;border-bottom:1px solid #ddd}.badge{padding:3px 8px;border-radius:10px;color:white;font-size:0.75rem;font-weight:bold}.badge-PENDING{background:#f39c12}.badge-ACCEPTED{background:#2980b9}.badge-REJECTED{background:#c0392b}.btn{display:inline-block;padding:6px 12px;border-radius:4px;text-decoration:none;font-size:0.85rem;margin:2px}.btn-primary{background:#0b5e2f;color:white}.btn-success{background:#2980b9;color:white}.btn-danger{background:#c0392b;color:white}</style>
</head><body>
<div class="top-bar"><h1>Applications</h1><nav class="nav"><a href="/admin/dashboard">Dashboard</a><a href="/admin/programs">Programmes</a><a href="/admin/applications">Applications</a><a href="/admin/settings">Settings</a><a href="/admin/logout">Logout</a></nav></div>
<div class="container"><div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;margin-bottom:15px"><h2>Applications</h2><form method="GET" action="/admin/applications"><select name="filter" onchange="this.form.submit()" style="padding:8px;border-radius:4px"><option value="ALL" <%= filter=='ALL'?'selected':'' %>>All</option><option value="PENDING" <%= filter=='PENDING'?'selected':'' %>>Pending</option><option value="ACCEPTED" <%= filter=='ACCEPTED'?'selected':'' %>>Accepted</option><option value="REJECTED" <%= filter=='REJECTED'?'selected':'' %>>Rejected</option></select></form></div>
<div class="card"><table><tr><th>App ID</th><th>Student</th><th>Programme</th><th>Type</th><th>Status</th><th>Docs</th><th>Action</th></tr>
<% applications.forEach(app => { %><tr><td><%= app.id %></td><td><%= app.student %></td><td><%= app.progName %></td><td><%= app.courseType || '-' %></td>
<td><span class="badge badge-<%= app.status %>"><%= app.status %></span></td>
<td><% if(app.grade12File) { %><a href="/uploads/<%= app.grade12File %>" target="_blank" class="btn btn-primary">G12</a><% } %><% if(app.nrcFile) { %><a href="/uploads/<%= app.nrcFile %>" target="_blank" class="btn btn-primary">NRC</a><% } %><% if(!app.grade12File && !app.nrcFile){ %>–<% } %></td>
<td><a href="/admin/review/<%= app.id %>" class="btn btn-primary">Review</a>
<% if(app.status=='PENDING'){ %><a href="/admin/accept/<%= app.id %>" class="btn btn-success">Accept</a> <a href="/admin/reject/<%= app.id %>" class="btn btn-danger">Reject</a><% } %></td></tr><% }) %>
</table></div></div>
<footer style="background:#0b5e2f;color:white;padding:15px;text-align:center;margin-top:30px;">&copy; 2026 Admin Panel</footer>
</body></html>
