<%- include('partials/admin_header') %>
<h2 class="text-green-dark mb-4">Admin Dashboard</h2>
<div class="row g-3 mb-4">
  <div class="col-6 col-md-3"><div class="card bg-primary text-white shadow-sm"><div class="card-body"><h5 class="mb-1"><%= applications.length %></h5><p class="mb-0">Total Applications</p></div></div></div>
  <div class="col-6 col-md-3"><div class="card bg-warning shadow-sm"><div class="card-body"><h5 class="mb-1"><%= pending %></h5><p class="mb-0">Pending</p></div></div></div>
  <div class="col-6 col-md-3"><div class="card bg-success text-white shadow-sm"><div class="card-body"><h5 class="mb-1"><%= approved %></h5><p class="mb-0">Approved</p></div></div></div>
  <div class="col-6 col-md-3"><div class="card bg-info text-white shadow-sm"><div class="card-body"><h5 class="mb-1"><%= programs.length %></h5><p class="mb-0">Programmes</p></div></div></div>
</div>
<div class="text-center mt-4">
  <a href="/admin/applications" class="btn btn-gold btn-lg"><i class="fas fa-th-large me-2"></i>Manage Applications</a>
</div>
<%- include('partials/admin_footer') %>
