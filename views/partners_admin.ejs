<%- include('partials/admin_header') %>
<h2 class="text-green-dark mb-4">Manage Partners</h2>
<div class="row">
  <div class="col-md-5">
    <div class="card mb-4">
      <div class="card-body">
        <h5>Add Partner</h5>
        <form method="POST" action="/admin/partners/add" enctype="multipart/form-data">
          <div class="mb-3"><label>Partner Name</label><input name="name" class="form-control" required></div>
          <div class="mb-3"><label>Logo</label><input type="file" name="logo" class="form-control" accept="image/*" required></div>
          <button type="submit" class="btn btn-gold">Add Partner</button>
        </form>
      </div>
    </div>
  </div>
  <div class="col-md-7">
    <h5>Current Partners</h5>
    <% if (partners.length === 0) { %><p class="text-muted">No partners yet.</p><% } %>
    <div class="row">
      <% partners.forEach(p => { %>
        <div class="col-md-6 mb-3">
          <div class="card h-100">
            <div class="card-body text-center">
              <img src="<%= p.logo %>" alt="<%= p.name %>" style="max-height:60px;" class="img-fluid">
              <p class="mb-1"><%= p.name %></p>
              <form method="POST" action="/admin/partners/delete/<%= p.id %>">
                <button class="btn btn-sm btn-outline-danger">Delete</button>
              </form>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  </div>
</div>
<%- include('partials/admin_footer') %>
