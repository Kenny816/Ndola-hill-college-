<%- include('partials/header') %>

<section class="bg-green-dark text-white py-5 text-center fade-up">
  <div class="container">
    <h1 class="display-5 fw-bold">Our Programmes</h1>
    <p class="lead mb-0">Choose from accredited technical and vocational courses designed for Zambia's key industries.</p>
  </div>
</section>

<div class="container my-5">
  <div class="row mb-4 fade-up">
    <div class="col-md-6 mx-auto">
      <div class="input-group">
        <span class="input-group-text bg-white"><i class="fas fa-search text-green-dark"></i></span>
        <input type="text" id="programmeSearch" class="form-control" placeholder="Search programmes...">
      </div>
    </div>
  </div>

  <div class="row g-4" id="programmesGrid">
    <% programs.forEach(function(program) { %>
      <div class="col-md-6 col-lg-4 programme-card" data-name="<%= program.name %>" data-type="<%= program.type %>">
        <div class="card h-100 shadow-sm border-0 programme-card-inner">
          <% if (program.image) { %>
            <img src="<%= program.image %>" class="card-img-top" alt="<%= program.name %>" style="height:180px; object-fit:cover;">
          <% } %>
          <div class="card-body">
            <div class="d-flex justify-content-between align-items-start mb-3">
              <h3 class="card-title h5 fw-bold"><%= program.name %></h3>
              <span class="badge bg-green-dark"><%= program.type %></span>
            </div>

            <% if (program.applicationfee) { %>
              <p class="card-text text-muted small">
                <i class="fas fa-file-invoice-dollar me-2"></i><strong>Application Fee:</strong> ZMW <%= program.applicationfee %>
              </p>
            <% } %>

            <% if (program.entryrequirements) { %>
              <p class="card-text text-muted small">
                <i class="fas fa-check-circle me-2"></i><%= program.entryrequirements %>
              </p>
            <% } %>

            <% if (program.duration) { %>
              <p class="card-text text-muted small">
                <i class="fas fa-clock me-2"></i><strong>Duration:</strong> <%= program.duration %>
              </p>
            <% } %>

            <% if (program.fee) { %>
              <p class="card-text text-muted small">
                <i class="fas fa-money-bill-wave me-2"></i><strong>Annual Fee:</strong> ZMW <%= program.fee %>
              </p>
            <% } %>

            <% if (program.capacity) { %>
              <p class="card-text text-muted small">
                <i class="fas fa-users me-2"></i><strong>Capacity:</strong> <%= program.capacity %> students
              </p>
            <% } %>

            <a href="/program/<%= program.id %>" class="btn btn-gold btn-sm mt-2">
              <i class="fas fa-info-circle me-1"></i>View Details
            </a>
          </div>
        </div>
      </div>
    <% }) %>
  </div>

  <div id="noResults" class="text-center py-5 d-none">
    <i class="fas fa-search fa-3x text-muted mb-3"></i>
    <h4>No programmes found</h4>
    <p class="text-muted">Try adjusting your search term.</p>
  </div>
</div>

<%- include('partials/footer') %>

<script>
  document.getElementById('programmeSearch').addEventListener('input', function(e) {
    var query = e.target.value.toLowerCase();
    var cards = document.querySelectorAll('.programme-card');
    var visible = 0;
    cards.forEach(function(card) {
      var name = card.getAttribute('data-name').toLowerCase();
      var type = card.getAttribute('data-type').toLowerCase();
      if (name.indexOf(query) > -1 || type.indexOf(query) > -1) {
        card.style.display = '';
        visible++;
      } else {
        card.style.display = 'none';
      }
    });
    document.getElementById('noResults').classList.toggle('d-none', visible > 0);
  });
</script>
