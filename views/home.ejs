<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Ndola Hill College – Excellence in Mining Education</title>
  <style>
    :root { --green-dark: #0b5e2f; --gold: #d4a017; }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: 'Segoe UI', sans-serif; background: #f4f6f8; color: #333; }
    .top-bar { background: var(--green-dark); color: white; padding: 12px 20px; display: flex; justify-content: space-between; align-items: center; position: relative; }
    .nav a { color: white; margin: 0 10px; text-decoration: none; font-weight: 500; }
    .hamburger { display: none; }
    #menu-toggle { display: none; }
    .mobile-menu { display: none; }
    @media (max-width: 768px) {
      .nav { display: none; } .hamburger { display: flex; flex-direction: column; }
      #menu-toggle:checked ~ .mobile-menu { display: block; position: absolute; top: 60px; left: 0; width: 100%; background: var(--green-dark); }
    }
    .hero { background: linear-gradient(rgba(0,0,0,0.6), rgba(0,0,0,0.6)), url('https://images.unsplash.com/photo-1523050854058-8df90910f7c3?ixlib=rb-4.0.3&auto=format&fit=crop&w=1350&q=80') center/cover; color: white; padding: 100px 20px; text-align: center; }
    .hero h2 { font-size: 2.5rem; margin-bottom: 15px; }
    .btn { display: inline-block; padding: 12px 30px; background: var(--gold); color: #000; border-radius: 30px; text-decoration: none; font-weight: bold; }
    .container { max-width: 1200px; margin: 0 auto; padding: 40px 20px; }
    .stats { display: flex; justify-content: space-around; text-align: center; flex-wrap: wrap; gap: 20px; margin-bottom: 40px; }
    .stat-item { background: white; padding: 20px; border-radius: 12px; box-shadow: 0 2px 8px rgba(0,0,0,0.05); flex: 1 1 200px; }
    .stat-number { font-size: 2rem; font-weight: bold; color: var(--green-dark); }
    .section-title { text-align: center; margin-bottom: 30px; color: var(--green-dark); }
    .partners { display: flex; justify-content: center; flex-wrap: wrap; gap: 30px; margin-bottom: 40px; }
    .partner-logo { background: white; padding: 10px; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.05); }
    .testimonials { display: flex; gap: 20px; overflow-x: auto; padding-bottom: 10px; }
    .testimonial-card { background: white; padding: 20px; border-radius: 12px; box-shadow: 0 2px 8px rgba(0,0,0,0.05); min-width: 250px; flex: 1; }
    .cta { background: var(--green-dark); color: white; text-align: center; padding: 40px 20px; border-radius: 12px; margin: 40px 0; }
  </style>
</head>
<body>
<div class="top-bar">
  <div><h1>Ndola Hill College</h1><span style="font-size:0.8rem">"Developing Skills, Building Futures"</span></div>
  <label class="hamburger" for="menu-toggle"><span></span><span></span><span></span></label>
  <div class="nav">
    <a href="/">Home</a><a href="/programmes">Programmes</a><a href="/apply">Apply Now</a><a href="/about">About</a><a href="/contact">Contact</a>
  </div>
</div>
<input type="checkbox" id="menu-toggle">
<div class="mobile-menu">
  <a href="/">Home</a><a href="/programmes">Programmes</a><a href="/apply">Apply Now</a><a href="/about">About</a><a href="/contact">Contact</a>
</div>

<div class="hero">
  <h2>Build Your Future in Mining &amp; Engineering</h2>
  <p>Gain practical skills for Zambia's most vibrant industries.</p>
  <a href="/apply" class="btn">Start Application</a>
</div>

<div class="container">
  <!-- Stats Section -->
  <div class="stats">
    <div class="stat-item"><div class="stat-number">2,500+</div><p>Graduates</p></div>
    <div class="stat-item"><div class="stat-number">87%</div><p>Employment Rate</p></div>
    <div class="stat-item"><div class="stat-number">13,000+</div><p>Industry Jobs Supported</p></div>
    <div class="stat-item"><div class="stat-number">15+</div><p>Programmes</p></div>
  </div>

  <!-- Partners Section -->
  <h2 class="section-title">Our Industry Partners</h2>
  <div class="partners">
    <% partners.forEach(partner => { %>
      <div class="partner-logo"><img src="<%= partner.logo %>" alt="<%= partner.name %>"></div>
    <% }) %>
  </div>

  <!-- Testimonials Section -->
  <h2 class="section-title">What Our Graduates Say</h2>
  <div class="testimonials">
    <% testimonials.forEach(t => { %>
      <div class="testimonial-card">
        <p style="font-style:italic">"<%= t.quote %>"</p>
        <strong><%= t.name %></strong><br><small><%= t.role %></small>
      </div>
    <% }) %>
  </div>

  <!-- Call to Action -->
  <div class="cta">
    <h2>Ready to start your journey?</h2>
    <a href="/apply" class="btn" style="background:white;color:var(--green-dark)">Apply Now</a>
  </div>
</div>

<%- include('partials/footer') %>
</body>
</html>
