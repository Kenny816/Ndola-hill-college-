<%- include('partials/header') %>
<section class="bg-green-dark text-white py-5 text-center">
  <div class="container">
    <h1 class="display-5 fw-bold"><i class="fas fa-check-circle me-2"></i>Application Submitted!</h1>
    <p class="lead mb-0">Thank you for applying to Ndola Hill College.</p>
  </div>
</section>
<div class="container my-5">
  <div class="row justify-content-center">
    <div class="col-md-6 text-center">
      <div class="card shadow-sm p-4">
        <i class="fas fa-file-alt fa-4x text-green-dark mb-3"></i>
        <h4 class="mb-3">Your Application ID is:</h4>
        <h2 class="text-green-dark display-6 fw-bold"><%= applicationId %></h2>
        <p class="text-muted mt-2">Please write down or save this ID.<br>You'll need it to track your application status.</p>
        <a href="/track" class="btn btn-gold mt-3"><i class="fas fa-search me-1"></i>Track Your Application</a>
      </div>
    </div>
  </div>
</div>
<%- include('partials/footer') %>
