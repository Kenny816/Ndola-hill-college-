<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Apply Now – Ndola Hill College</title>
  <style>
    :root { --green-dark: #0b5e2f; --gold: #d4a017; }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: 'Segoe UI', system-ui, sans-serif; background: #f4f6f8; color: #333; }
    .top-bar { background: var(--green-dark); color: white; padding: 12px 20px; display: flex; justify-content: space-between; align-items: center; position: relative; box-shadow: 0 2px 12px rgba(0,0,0,0.1); }
    .logo h1 { font-size: 1.5rem; }
    .logo .tagline { font-size: 0.8rem; opacity: 0.9; }
    .nav a { color: white; margin: 0 10px; text-decoration: none; font-weight: 500; }
    .nav a:hover, .nav a.active { border-bottom: 2px solid var(--gold); }
    .hamburger { display: none; flex-direction: column; cursor: pointer; }
    .hamburger span { width: 25px; height: 3px; background: white; margin: 2px 0; }
    #menu-toggle { display: none; }
    .mobile-menu { display: none; background: var(--green-dark); position: absolute; top: 60px; left: 0; width: 100%; z-index: 100; flex-direction: column; }
    .mobile-menu a { color: white; padding: 12px 20px; text-decoration: none; border-bottom: 1px solid rgba(255,255,255,0.1); }
    .container { max-width: 700px; margin: 30px auto; padding: 0 20px; }
    .form-card { background: white; padding: 30px; border-radius: 12px; box-shadow: 0 5px 20px rgba(0,0,0,0.05); }
    label { display: block; margin-bottom: 5px; font-weight: 600; }
    input, select { width: 100%; padding: 10px; margin-bottom: 15px; border: 1px solid #ddd; border-radius: 6px; }
    button { background: var(--green-dark); color: white; padding: 12px; border: none; border-radius: 6px; width: 100%; font-size: 1.1rem; cursor: pointer; font-weight: 600; }
    .upload-group { display: none; }
    .success { background: #d4edda; color: #155724; padding: 12px; border-radius: 6px; margin-bottom: 20px; }
    .error { background: #f8d7da; color: #721c24; padding: 12px; border-radius: 6px; margin-bottom: 20px; }
    @media (max-width: 768px) {
      .nav { display: none; }
      .hamburger { display: flex; }
      #menu-toggle:checked ~ .mobile-menu { display: flex; }
    }
    footer a:hover { text-decoration: underline; }
  </style>
</head>
<body>
<div class="top-bar">
  <div class="logo"><h1>Ndola Hill College</h1><div class="tagline">"Developing Skills, Building Futures"</div></div>
  <label class="hamburger" for="menu-toggle"><span></span><span></span><span></span></label>
  <div class="nav">
    <a href="/">Home</a><a href="/programmes">Programmes</a><a href="/apply" class="active">Apply Now</a><a href="/about">About</a><a href="/contact">Contact</a>
  </div>
</div>
<input type="checkbox" id="menu-toggle"><div class="mobile-menu"><a href="/">Home</a><a href="/programmes">Programmes</a><a href="/apply">Apply Now</a><a href="/about">About</a><a href="/contact">Contact</a></div>

<div class="container">
  <h1>Application Form</h1>
  <% if (success) { %><div class="success"><%= success %></div><% } %>
  <% if (error) { %><div class="error"><%= error %></div><% } %>
  <div class="form-card">
    <form method="POST" action="/apply" enctype="multipart/form-data">
      <label>Full Name *</label><input type="text" name="fullname" required>
      <label>Email *</label><input type="email" name="email" required>
      <label>Phone Number *</label><input type="tel" name="phone" required>
      <label>Choose Programme *</label>
      <select name="programme" required>
        <option value="">-- Select Programme --</option>
        <% programs.forEach(p => { %><option value="<%= p.id %>"><%= p.name %></option><% }) %>
      </select>
      <label>Course Type *</label>
      <select name="courseType" id="courseType" required onchange="toggleUploads()">
        <option value="">-- Select Type --</option>
        <option value="short">Short Course</option>
        <option value="long">Long-Term Programme</option>
        <option value="alevel">A-Levels</option>
      </select>
      <div id="nrcNumberGroup"><label>NRC Number *</label><input type="text" name="nrcNumber" placeholder="e.g., 123456/78/9" required></div>
      <div id="grade12Group" class="upload-group"><label>Grade 12 Certificate (scan/photo) *</label><input type="file" name="grade12File" accept=".pdf,.jpg,.jpeg,.png"><p class="file-note">PDF or image (max 5MB)</p></div>
      <div id="nrcUploadGroup" class="upload-group"><label>NRC Copy (scan/photo) *</label><input type="file" name="nrcFile" accept=".pdf,.jpg,.jpeg,.png"><p class="file-note">PDF or image (max 5MB)</p></div>
      <button type="submit">Submit Application</button>
    </form>
  </div>
</div>

<script>
  function toggleUploads() {
    const type = document.getElementById('courseType').value;
    const short = (type === 'short');
    document.getElementById('grade12Group').style.display = short ? 'none' : 'block';
    document.getElementById('nrcUploadGroup').style.display = short ? 'none' : 'block';
    const nrcInput = document.getElementById('nrcNumberGroup').querySelector('input');
    nrcInput.required = short;
  }
</script>

${FOOTER_HTML}
</body>
</html>
