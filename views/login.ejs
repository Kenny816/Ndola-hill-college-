<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Login - Ndola Hill College</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <style>
    :root { --green-dark: #0b5e2f; }
    body { background: #f4f6f8; display: flex; align-items: center; justify-content: center; min-height: 100vh; }
    .login-card { width: 100%; max-width: 400px; margin: 0 auto; }
    .btn-back { margin-top: 1rem; color: var(--green-dark); text-decoration: none; }
    .btn-back:hover { text-decoration: underline; }
  </style>
</head>
<body>
<div class="text-center">
  <div class="login-card card shadow">
    <div class="card-body p-4">
      <h4 class="text-green-dark mb-3"><i class="fas fa-lock me-2"></i>Admin Login</h4>
      <% if (typeof error !== 'undefined' && error) { %><div class="alert alert-danger"><%= error %></div><% } %>
      <form method="POST" action="/admin/login">
        <div class="mb-3"><input type="text" name="username" class="form-control" placeholder="Username" required></div>
        <div class="mb-3"><input type="password" name="password" class="form-control" placeholder="Password" required></div>
        <button type="submit" class="btn btn-success w-100" style="background-color: var(--green-dark);">Login</button>
      </form>
    </div>
  </div>
  <a href="/" class="btn-back mt-3 d-inline-block"><i class="fas fa-arrow-left me-1"></i>Back to Website</a>
</div>
</body>
</html>
