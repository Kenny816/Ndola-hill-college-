<%- include('partials/header') %>
<section class="bg-green-dark text-white py-5 text-center">
  <div class="container">
    <h1 class="display-5 fw-bold">Application Status</h1>
    <p class="lead mb-0">Details for <strong><%= application.fullName %></strong></p>
  </div>
</section>
<div class="container my-5">
  <div class="row justify-content-center">
    <div class="col-md-8">
      <div class="card shadow-sm mb-4">
        <div class="card-body p-4">
          <h4 class="text-green-dark mb-4"><i class="fas fa-info-circle me-2"></i>Application Information</h4>
          <div class="row">
            <div class="col-md-6">
              <p><strong>Application ID:</strong> <%= application.id %></p>
              <p><strong>Full Name:</strong> <%= application.fullName %></p>
              <p><strong>NRC:</strong> <%= application.nrc %></p>
            </div>
            <div class="col-md-6">
              <p><strong>Programme:</strong> <%= application.program %></p>
              <p><strong>Entry Year:</strong> <%= application.year %></p>
              <p><strong>Date Submitted:</strong> <%= application.date %></p>
            </div>
          </div>
          <hr>
          <div class="text-center">
            <h5>Current Status: 
              <span class="badge fs-6 <%= application.status === 'Approved' ? 'bg-success' : (application.status === 'Rejected' ? 'bg-danger' : 'bg-warning text-dark') %>">
                <%= application.status %>
              </span>
            </h5>
            <% if (application.status === 'Approved') { %>
              <p class="mt-3 text-success"><i class="fas fa-check-circle me-1"></i>Congratulations! You have been accepted.</p>
              <a href="/acceptance/<%= application.id %>?nrc=<%= application.nrc %>" class="btn btn-gold mt-2" target="_blank">
                <i class="fas fa-download me-1"></i>View / Download Acceptance Letter
              </a>
            <% } else if (application.status === 'Rejected') { %>
              <p class="text-danger mt-3">We regret to inform you that your application was not successful this intake.</p>
            <% } else { %>
              <p class="text-muted mt-3">Your application is still under review. Please check back later.</p>
            <% } %>
          </div>
        </div>
      </div>
      <a href="/track" class="btn btn-outline-green-dark"><i class="fas fa-search me-1"></i>Check Another Application</a>
    </div>
  </div>
</div>
<%- include('partials/footer') %>
