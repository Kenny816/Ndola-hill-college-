<!DOCTYPE html>
<html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Settings</title>
<style>body{margin:0;font-family:sans-serif;background:#f4f6f8}.top-bar{background:#0b5e2f;color:white;padding:12px 20px;display:flex;justify-content:space-between;align-items:center}.nav a{color:white;margin:0 10px;text-decoration:none}.container{max-width:500px;margin:20px auto;padding:0 20px}.card{background:white;padding:20px;border-radius:8px;box-shadow:0 2px 12px rgba(0,0,0,0.05)}input{width:100%;padding:8px;margin-bottom:10px;border:1px solid #ccc;border-radius:4px;box-sizing:border-box}button{background:#0b5e2f;color:white;padding:10px 20px;border:none;border-radius:4px;cursor:pointer}.message{color:green}.error{color:red}</style>
</head><body>
<div class="top-bar"><h1>Settings</h1><nav class="nav"><a href="/admin/dashboard">Dashboard</a><a href="/admin/programs">Programmes</a><a href="/admin/applications">Applications</a><a href="/admin/settings">Settings</a><a href="/admin/logout">Logout</a></nav></div>
<div class="container"><div class="card"><h2>Change Password</h2>
<% if(message) { %><p class="message"><%= message %></p><% } %>
<% if(error) { %><p class="error"><%= error %></p><% } %>
<form method="POST" action="/admin/settings">
<label>Current Password</label><input type="password" name="oldpass" required>
<label>New Password</label><input type="password" name="newpass1" required>
<label>Confirm New Password</label><input type="password" name="newpass2" required>
<button type="submit">Update Password</button></form></div></div>
<footer style="background:#0b5e2f;color:white;padding:15px;text-align:center;margin-top:30px;">&copy; 2026 Admin Panel</footer>
</body></html>
