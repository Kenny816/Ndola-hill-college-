<%- include('partials/admin_header') %>
<h2 class="text-green-dark mb-4">College Settings</h2>
<% if (typeof success !== 'undefined' && success) { %><div class="alert alert-success"><%= success %></div><% } %>
<% if (typeof error !== 'undefined' && error) { %><div class="alert alert-danger"><%= error %></div><% } %>
<div class="row">
  <div class="col-12 col-lg-6">
    <form method="POST" action="/admin/settings" enctype="multipart/form-data" class="mb-4">
      <div class="mb-3"><label>College Name</label><input name="collegeName" class="form-control" value="<%= settings.collegeName %>" required></div>
      <div class="mb-3"><label>Motto</label><input name="motto" class="form-control" value="<%= settings.motto %>"></div>
      <div class="mb-3"><label>Vision Statement</label><textarea name="vision" class="form-control" rows="3"><%= settings.vision %></textarea></div>
      <hr>
      <div class="mb-3"><label>Email</label><input name="email" class="form-control" value="<%= settings.email %>" required></div>
      <div class="mb-3"><label>Phone</label><input name="phone" class="form-control" value="<%= settings.phone %>"></div>
      <div class="mb-3"><label>Address</label><input name="address" class="form-control" value="<%= settings.address %>"></div>

      <h5 class="mt-4">Document Formats</h5>
      <div class="mb-3">
        <label>Allowed Upload Formats</label>
        <input name="allowedUploadFormats" class="form-control" value="<%= settings.allowedUploadFormats %>" placeholder=".pdf,.jpg,.jpeg,.png">
        <small class="text-muted">Comma-separated extensions, e.g. .pdf,.jpg,.png</small>
      </div>
      <div class="mb-3">
        <label>Allowed Download Formats</label>
        <input name="allowedDownloadFormats" class="form-control" value="<%= settings.allowedDownloadFormats %>" placeholder=".pdf,.jpg,.jpeg,.png">
        <small class="text-muted">Files with these extensions can be downloaded.</small>
      </div>

      <h5 class="mt-4">Images</h5>
      <!-- Logo -->
      <div class="mb-3">
        <label>Logo</label>
        <div class="d-flex align-items-center gap-2 mb-2">
          <% if (settings.logo) { %>
            <img src="<%= settings.logo %>" style="max-height:40px;">
            <a href="/admin/settings/delete-image?field=logo" class="btn btn-sm p-0 text-danger" title="Delete logo" onclick="return confirm('Delete logo?');"><i class="fas fa-trash"></i></a>
          <% } else { %><span class="text-muted small">Not set</span><% } %>
        </div>
        <input type="file" name="logo" class="form-control" accept="image/*">
      </div>
      <!-- Header Background -->
      <div class="mb-3">
        <label>Header Background</label>
        <div class="d-flex align-items-center gap-2 mb-2">
          <% if (settings.headerBg) { %>
            <img src="<%= settings.headerBg %>" style="max-height:40px;">
            <a href="/admin/settings/delete-image?field=headerBg" class="btn btn-sm p-0 text-danger" title="Delete" onclick="return confirm('Delete header background?');"><i class="fas fa-trash"></i></a>
          <% } else { %><span class="text-muted small">Not set</span><% } %>
        </div>
        <input type="file" name="headerBg" class="form-control" accept="image/*">
      </div>
      <!-- Hero Background -->
      <div class="mb-3">
        <label>Hero Background</label>
        <div class="d-flex align-items-center gap-2 mb-2">
          <% if (settings.heroBg) { %>
            <img src="<%= settings.heroBg %>" style="max-height:40px;">
            <a href="/admin/settings/delete-image?field=heroBg" class="btn btn-sm p-0 text-danger" title="Delete" onclick="return confirm('Delete hero background?');"><i class="fas fa-trash"></i></a>
          <% } else { %><span class="text-muted small">Not set</span><% } %>
        </div>
        <input type="file" name="heroBg" class="form-control" accept="image/*">
      </div>
      <hr>
      <h6>Trust Badges</h6>
      <% var bad = ['trustBadge1','trustBadge2','trustBadge3','trustBadge4']; %>
      <div class="row g-2">
        <% bad.forEach(function(b, i) { %>
          <div class="col-6">
            <label>Badge <%= i+1 %></label>
            <div class="d-flex align-items-center gap-2 mb-2">
              <% if (settings[b]) { %>
                <img src="<%= settings[b] %>" style="max-height:30px;">
                <a href="/admin/settings/delete-image?field=<%= b %>" class="btn btn-sm p-0 text-danger" title="Delete" onclick="return confirm('Delete this badge?');"><i class="fas fa-trash"></i></a>
              <% } else { %><span class="text-muted small">Not set</span><% } %>
            </div>
            <input type="file" name="<%= b %>" class="form-control" accept="image/*">
          </div>
        <% }) %>
      </div>

      <button type="submit" class="btn btn-gold mt-4">Save Settings</button>
    </form>
  </div>
  <div class="col-12 col-lg-6">
    <div class="card">
      <div class="card-body">
        <h5>Change Password</h5>
        <form method="POST" action="/admin/settings/password">
          <div class="mb-3"><label>New Password</label><input type="password" name="newPassword" class="form-control" required></div>
          <button type="submit" class="btn btn-outline-dark">Update Password</button>
        </form>
      </div>
    </div>
  </div>
</div>
<%- include('partials/admin_footer') %>
