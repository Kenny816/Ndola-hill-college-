<%- include('partials/header') %>
<section class="bg-green-dark text-white py-5 text-center">
  <div class="container">
    <h1 class="display-5 fw-bold">Contact Us</h1>
    <p class="lead mb-0">We'd love to hear from you.</p>
  </div>
</section>
<div class="container my-5">
  <div class="row">
    <div class="col-md-6 mb-4">
      <div class="card shadow-sm h-100 p-4">
        <h4 class="text-green-dark mb-3">Get in Touch</h4>
        <p><i class="fas fa-map-marker-alt me-2 text-green-dark"></i> Mpelembe House, 5th Floor, Room 509, Ndola, Zambia</p>
        <p><a href="https://wa.me/260971234567" class="text-dark text-decoration-none"><i class="fab fa-whatsapp me-2 text-success"></i>+260 97 1234567</a></p>
        <p><a href="mailto:info@ndolahillcollege.edu.zm" class="text-dark text-decoration-none"><i class="fas fa-envelope me-2 text-green-dark"></i>info@ndolahillcollege.edu.zm</a></p>
      </div>
    </div>
    <div class="col-md-6">
      <div class="card shadow-sm p-4">
        <h4 class="text-green-dark mb-3">Send a Message</h4>
        <% if (typeof success !== 'undefined' && success) { %><div class="alert alert-success">Message sent successfully!</div><% } %>
        <form method="POST" action="/contact">
          <div class="mb-3">
            <label class="form-label">Name</label>
            <input type="text" name="name" class="form-control" required>
          </div>
          <div class="mb-3">
            <label class="form-label">Email</label>
            <input type="email" name="email" class="form-control" required>
          </div>
          <div class="mb-3">
            <label class="form-label">Message</label>
            <textarea name="message" class="form-control" rows="4" required></textarea>
          </div>
          <button type="submit" class="btn btn-gold">Send Message</button>
        </form>
      </div>
    </div>
  </div>
</div>
<%- include('partials/footer') %>
