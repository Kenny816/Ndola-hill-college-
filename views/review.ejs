<%- include('partials/admin_header') %>
<h2 class="text-green-dark mb-4"><i class="fas fa-times-circle me-2"></i>Rejected Applications</h2>
<p class="text-muted">These applications were not accepted.</p>
<div class="row g-4">
  <% if (applications.length === 0) { %><div class="col-12"><p class="text-muted">No rejected applications.</p></div><% } %>
  <% applications.forEach(function(app, idx) { %>
    <div class="col-xl-4 col-lg-6">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body d-flex flex-column">
          <h5 class="fw-bold"><%= app.fullName %></h5>
          <p class="mb-1"><i class="fas fa-graduation-cap me-1 text-muted"></i><%= app.program %></p>
          <p class="mb-1 small"><i class="fas fa-phone-alt me-1 text-muted"></i><%= app.phone %></p>
          <p class="mb-0 small"><i class="fas fa-calendar-alt me-1 text-muted"></i>Rejected: <%= app.date %></p>
          <div class="mt-auto d-flex gap-2 flex-wrap mt-2">
            <button class="btn btn-outline-secondary btn-sm" data-bs-toggle="modal" data-bs-target="#reviewModal<%= idx %>"><i class="fas fa-eye me-1"></i>View Details</button>
            <form method="POST" action="/admin/applications/delete/<%= app.id %>" class="d-inline" onsubmit="return confirm('Delete permanently?');">
              <button type="submit" class="btn btn-outline-danger btn-sm"><i class="fas fa-trash me-1"></i>Delete</button>
            </form>
          </div>
        </div>
      </div>
    </div>
    <!-- Detail Modal -->
    <div class="modal fade" id="reviewModal<%= idx %>" tabindex="-1" aria-hidden="true">
      <div class="modal-dialog modal-lg">
        <div class="modal-content">
          <div class="modal-header bg-green-dark text-white">
            <h5 class="modal-title"><%= app.fullName %></h5>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
          </div>
          <div class="modal-body">
            <div class="row">
              <div class="col-md-6">
                <p><strong>Application ID:</strong> <%= app.id %></p>
                <p><strong>NRC:</strong> <%= app.nrc %></p>
                <p><strong>Phone:</strong> <%= app.phone %></p>
                <p><strong>Email:</strong> <%= app.email %></p>
                <p><strong>Programme:</strong> <%= app.program %></p>
                <p><strong>Entry Year:</strong> <%= app.year %></p>
              </div>
              <div class="col-md-6">
                <p><strong>Date of Birth:</strong> <%= app.dob || '—' %></p>
                <p><strong>Gender:</strong> <%= app.gender || '—' %></p>
                <p><strong>Address:</strong> <%= app.address || '—' %></p>
                <p><strong>School:</strong> <%= app.school || '—' %></p>
                <p><strong>Year Completed:</strong> <%= app.yearCompleted || '—' %></p>
              </div>
            </div>
            <% if (app.motivation) { %><hr><h6>Motivation</h6><p><%= app.motivation %></p><% } %>
            <hr>
            <h6>Uploaded Documents</h6>
            <% ['grade12','nrc_copy','photo'].forEach(function(doc) { %>
              <div class="mb-2">
                <strong><%= doc === 'grade12' ? 'Grade 12 Results' : (doc === 'nrc_copy' ? 'NRC Copy' : 'Passport Photo') %>:</strong>
                <% if (app.documents && app.documents[doc]) { %>
                  <a href="<%= app.documents[doc] %>" target="_blank" class="ms-2"><i class="fas fa-eye"></i> View</a>
                  <a href="/download/<%= app.documents[doc].split('/').pop() %>" class="ms-2"><i class="fas fa-download"></i> Download</a>
                  <form method="POST" action="/admin/documents/delete" class="d-inline ms-2" onsubmit="return confirm('Delete this file?')">
                    <input type="hidden" name="appId" value="<%= app.id %>">
                    <input type="hidden" name="field" value="<%= doc %>">
                    <input type="hidden" name="filename" value="<%= app.documents[doc].split('/').pop() %>">
                    <button type="submit" class="btn btn-sm p-0 text-danger" title="Delete file"><i class="fas fa-trash-alt"></i></button>
                  </form>
                <% } else { %><span class="text-muted ms-2">Not uploaded</span><% } %>
              </div>
            <% }) %>
          </div>
        </div>
      </div>
    </div>
  <% }) %>
</div>
<%- include('partials/admin_footer') %>
