<%- include('partials/admin_header') %>
<h2 class="text-green-dark mb-4"><%= program ? 'Edit' : 'Add' %> Programme</h2>
<form method="POST" action="/admin/programs/save" enctype="multipart/form-data">
  <input type="hidden" name="id" value="<%= program ? program.id : '' %>">
  <div class="row g-3">
    <div class="col-md-6"><label>Name</label><input name="name" class="form-control" value="<%= program ? program.name : '' %>" required></div>
    <div class="col-md-6"><label>Type</label><select name="type" class="form-select" required>
      <option value="Degree" <%= program && program.type==='Degree' ? 'selected' : '' %>>Degree</option>
      <option value="Diploma" <%= program && program.type==='Diploma' ? 'selected' : '' %>>Diploma</option>
      <option value="Certificate" <%= program && program.type==='Certificate' ? 'selected' : '' %>>Certificate</option>
    </select></div>
    <div class="col-md-4"><label>Duration</label><input name="duration" class="form-control" value="<%= program ? program.duration : '' %>"></div>
    <div class="col-md-4"><label>Annual Fee (ZMW)</label><input name="fee" type="number" class="form-control" value="<%= program ? program.fee : '' %>"></div>
    <div class="col-md-4"><label>Capacity</label><input name="capacity" type="number" class="form-control" value="<%= program ? program.capacity : '' %>"></div>
    <div class="col-md-4"><label>Application Fee</label><input name="applicationFee" type="number" class="form-control" value="<%= program ? program.applicationFee : '' %>"></div>
    <div class="col-md-8"><label>Entry Requirements</label><input name="entryRequirements" class="form-control" value="<%= program ? program.entryRequirements : '' %>"></div>
    <div class="col-12"><label>Description</label><textarea name="description" class="form-control" rows="3"><%= program ? program.description : '' %></textarea></div>
    <div class="col-md-6"><label>Image (optional)</label><input type="file" name="image" class="form-control"></div>
    <% if (program && program.image) { %><div class="col-md-6"><img src="<%= program.image %>" style="max-height:100px;"></div><% } %>
  </div>
  <button type="submit" class="btn btn-gold mt-3">Save Programme</button>
</form>
<%- include('partials/admin_footer') %>
