<%- include('partials/header') %>

<section class="bg-green-dark text-white py-5 text-center fade-up">
  <div class="container">
    <h1 class="display-5 fw-bold">Our Programmes</h1>
    <p class="lead mb-0">Choose from accredited courses. Full details are provided upon acceptance.</p>
  </div>
</section>

<div class="container my-5">
  <!-- Search & Filter Bar -->
  <div class="row mb-4 fade-up">
    <div class="col-md-6 mx-auto">
      <div class="input-group">
        <span class="input-group-text bg-white"><i class="fas fa-search text-green-dark"></i></span>
        <input type="text" id="programmeSearch" class="form-control" placeholder="Search programmes..." aria-label="Search">
      </div>
    </div>
  </div>

  <!-- Programme Cards Grid -->
  <div class="row g-4" id="programmesGrid">
    <% programs.forEach(function(program) { %>
      <div class="col-md-6 col-lg-4 programme-card" data-name="<%= (program.name||'').toLowerCase() %>">
        <div class="card h-100 shadow-sm border-0 programme-card-inner">
          <div class="card-body d-flex flex-column">
            <h3 class="h5 fw-bold"><%= program.name %></h3>
            <span class="badge bg-green-dark align-self-start mb-3"><%= program.type %></span>
            <p class="small text-muted mb-1"><i class="fas fa-file-invoice-dollar me-2"></i>Application Fee: ZMW <%= program.applicationFee %></p>
            <p class="small text-muted"><i class="fas fa-check-circle me-2"></i><%= program.entryRequirements %></p>
            <a href="/program/<%= program.id %>" class="btn btn-gold btn-sm mt-auto align-self-start">View Requirements</a>
          </div>
        </div>
      </div>
    <% }) %>
  </div>

  <div id="noResults" class="text-center py-5 d-none">
    <i class="fas fa-search fa-3x text-muted mb-3"></i>
    <h4>No programmes found</h4>
    <p class="text-muted">Try adjusting your search term.</p>
  </div>
</div>

<%- include('partials/footer') %>

<script>
  document.getElementById('programmeSearch').addEventListener('input', function(e) {
    const query = e.target.value.toLowerCase();
    const cards = document.querySelectorAll('.programme-card');
    let visible = 0;
    cards.forEach(card => {
      const name = card.getAttribute('data-name');
      if (name.includes(query)) {
        card.style.display = '';
        visible++;
      } else {
        card.style.display = 'none';
      }
    });
    document.getElementById('noResults').classList.toggle('d-none', visible > 0);
  });
</script>
