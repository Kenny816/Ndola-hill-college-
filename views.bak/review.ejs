<%- include('partials/header') %>
<div class="container my-4">
  <h1 class="text-green-dark mb-4">Application Review</h1>
  <div class="table-responsive">
    <table class="table table-bordered">
      <thead><tr><th>Name</th><th>Programme</th><th>Status</th><th>Action</th></tr></thead>
      <tbody>
        <% applications.forEach(function(app){ %>
          <tr>
            <td><%= app.fullName %></td>
            <td><%= app.program %></td>
            <td><%= app.status %></td>
            <td>
              <form method="POST" action="/admin/approve/<%= app.id %>">
                <button class="btn btn-success btn-sm">Approve</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>
<%- include('partials/footer') %>
